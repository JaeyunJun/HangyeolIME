// 서명 신원 덮어쓰기 템플릿 (선택).
//
// 기본값은 로컬 자체 서명 인증서 "HangyeolIME Local Signing"이다(Signing.xcconfig).
// 대부분은 이 파일이 필요 없다. 다른 신원(예: Apple Development)으로 서명하고 싶을 때만
// 이 파일을 같은 폴더에 "Local.xcconfig"로 복사해 값을 채운다. (.gitignore 대상)
//
// 본인 Team ID 확인 방법(터미널):
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
//   → 출력의 OU=XXXXXXXXXX 가 본인 Team ID 입니다.

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = YOUR_TEAM_ID
